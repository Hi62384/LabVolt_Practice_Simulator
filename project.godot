; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="College Simulator"
config/description="A cooperative first-person AC electrical laboratory with authoritative ENet multiplayer."
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/LabVolt Cooperative Lab"
config/features=PackedStringArray("4.5", "C#", "Mobile")

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="CollegeSimulator"

[editor_plugins]

enabled=PackedStringArray("res://addons/campus_visual_preview/plugin.cfg")

[network]

labvolt/claim_authority_url="https://labvolt-claim-authority.arshya-ghafaryan.workers.dev"

[rendering]

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
limits/opengl/max_renderable_lights=64
anti_aliasing/quality/use_debanding=true
environment/volumetric_fog/volume_size=32
environment/volumetric_fog/volume_depth=32
