extends SceneTree
const Ledger=preload("res://scripts/inventory_authority/ledger.gd")
const Profile=preload("res://scripts/electronics_profile.gd")
const Store=preload("res://scripts/inventory_authority/store.gd")
func _initialize():call_deferred("run")
func run():
 var isolated=OS.get_environment("LABVOLT_ECONOMY_RUN_ROOT").replace("\\","/").simplify_path().to_lower().trim_suffix("/")
 if isolated.is_empty() or not OS.get_user_data_dir().replace("\\","/").simplify_path().to_lower().begins_with(isolated+"/"):
  push_error("Refusing non-isolated economy test saves");quit(2);return
 var p=Profile.new();p.open("economy-operation-extra");p.data.dollars=1000
 var ledger=Ledger.new();assert(ledger.open("user://operation-extra")==OK)
 for i in [1,2]:assert(ledger.bind(i,str(i).repeat(48),str(i+4).repeat(64),p.data).ok)
 assert(ledger.transact(1,"analyzer","analyzer",[]).ok)
 var before=ledger.state.duplicate(true)
 assert(not ledger.transact(1,"analyzer-again","analyzer",[]).ok and Profile.same(before,ledger.state))
 assert(ledger.transact(1,"cosmetic","cosmetic",["gold_safety"]).ok)
 before=ledger.state.duplicate(true)
 assert(not ledger.transact(1,"cosmetic-again","cosmetic",["gold_safety"]).ok and Profile.same(before,ledger.state))
 assert(ledger.transact(1,"box","box",["Basic assortment"]).ok)
 assert(ledger.transact(1,"bundle","bundle",[{"diode":6,"led":6}]).ok)
 for action in [["bad-box","box",["unknown"]],["bad-custom","obtain",["ic:missing",true]],["bad-purchase","buy",["missing",1]]]:
  before=ledger.state.duplicate(true)
  assert(not ledger.transact(1,action[0],action[1],action[2]).ok and Profile.same(before,ledger.state))
 p.data.dollars=0
 assert(ledger.bind(3,"3".repeat(48),"7".repeat(64),p.data).ok)
 before=ledger.state.duplicate(true)
 assert(not ledger.transact(3,"retry-poor","buy",["r1000",1]).ok and Profile.same(before,ledger.state))
 assert(ledger.award(3,"real-host-reward",100,0,false).ok)
 assert(ledger.transact(3,"retry-poor","buy",["r1000",1]).ok)
 var receipt=ledger.exchange("stable-replay",[1,2],{1:{"r1000":1},2:{}},{})
 assert(receipt.ok and not receipt.has("request"))
 var reopened=Ledger.new();assert(reopened.open(ledger.store.path)==OK)
 assert(reopened.bind(11,"1".repeat(48),"5".repeat(64),p.data).ok)
 assert(reopened.bind(22,"2".repeat(48),"6".repeat(64),p.data).ok)
 before=reopened.state.duplicate(true)
 var replay=reopened.exchange("stable-replay",[22,11],{11:{"r1000":1},22:{}},{})
 assert(replay.ok and Profile.same(replay,receipt) and Profile.same(reopened.state,before))
 var legacy=before.duplicate(true);legacy.transactions["stable-replay"].erase("request")
 assert(reopened.persist(legacy))
 var persisted: Dictionary=reopened.state.duplicate(true)
 var saved_legacy: Dictionary=reopened.receipt_history.lookup_trade(reopened.state,"stable-replay")
 assert(saved_legacy.ok and saved_legacy.found and not saved_legacy.value.has("request") and saved_legacy.value.deliveries==receipt.deliveries)
 assert(not reopened.exchange("stable-replay",[22,11],{11:{"r1000":1},22:{}},{}).ok)
 var after_legacy: Dictionary=reopened.receipt_history.lookup_trade(reopened.state,"stable-replay")
 assert(Profile.same(reopened.state,persisted) and after_legacy.ok and after_legacy.found and Profile.same(after_legacy.value,saved_legacy.value))
 var store=Store.new();assert(store.open("user://torn-header-extra")==OK);assert(store.commit({"marker":1})==OK);assert(store.commit({"marker":2})==OK)
 for bad in [PackedByteArray(),PackedByteArray([1]),PackedByteArray([255,255,255,127]),PackedByteArray([0,0,0,0]),PackedByteArray([4,0,0,0,1])]:
  var f=FileAccess.open("user://torn-header-extra.0",FileAccess.WRITE);f.store_buffer(bad);f.close()
  var recover=Store.new();assert(recover.open("user://torn-header-extra")==OK and recover.value.marker==1)
 print("PASS explicit purchase outcomes, all paid operation families, failed-ID retry, stable identity/reversed peer replay, retained legacy receipt and five torn frames")
 quit()
