extends SceneTree
func _initialize():
	var station=load("res://scripts/dc_station.gd").new()
	var board=load("res://scripts/breadboard_model.gd").empty()
	board.parts=[{"id":"b","type":"button","a":"A1","b":"A2"},{"id":"t","type":"toggle","a":"A3","b":"A4"},{"id":"p","type":"pot10k","a":"A5","b":"A6","pins":["A5","A6","A7"],"setting":.5}]
	assert(station.apply({"op":"board","design":board})=="")
	assert(station.apply({"op":"input","id":"t"})=="")
	assert(station.board.parts[1].pressed)
	station.apply({"op":"input","id":"t"});assert(not station.board.parts[1].pressed)
	assert(station.apply({"op":"input","id":"t","pressed":false})=="")
	assert(not station.board.parts[1].pressed,"Releasing a toggle must not turn it on")
	assert(station.apply({"op":"input","id":"t","pressed":"false"})!="")
	assert(not station.board.parts[1].pressed,"An invalid pressed value must not toggle the switch")
	assert(station.apply({"op":"input","id":"t","reverse":"true"})!="")
	assert(not station.board.parts[1].pressed,"An invalid direction must not toggle the switch")
	for i in 30:station.apply({"op":"input","id":"p"})
	assert(station.board.parts[2].setting==1)
	for i in 30:station.apply({"op":"input","id":"p","reverse":true})
	assert(station.board.parts[2].setting==0)
	assert(station.apply({"op":"input","id":"p","pressed":false})=="")
	assert(station.board.parts[2].setting==0,"Releasing an analog adjustment must not change its setting")
	var source_board=load("res://scripts/breadboard_model.gd").empty()
	source_board.parts=[{"id":"src","type":"battery_generator_adjustable","a":"A1","b":"F1"}]
	assert(station.apply({"op":"board","design":source_board})=="")
	assert(station.apply({"op":"input","id":"src","source_adjust":"unknown"})!="")
	assert(station.board.get("controls",{}).get("board/src",{}).is_empty(), "Invalid generator settings must not modify state")
	assert(station.apply({"op":"input","id":"src","source_adjust":"voltage","pressed":false})=="")
	assert(station.board.get("controls",{}).get("board/src",{}).is_empty(), "Source release must not adjust voltage")
	assert(station.apply({"op":"input","id":"src","source_adjust":"voltage","pressed":true})=="")
	assert(is_equal_approx(float(station.board.controls["board/src"].source_voltage),5.5),"Valid source adjustment must still work")
	assert(station.apply({"op":"board","design":board})=="")
	station.apply({"op":"input","id":"b"});assert(station.board.parts[0].pressed)
	for i in 510:station.step()
	assert(not station.board.parts[0].pressed)
	assert(station.apply({"op":"input","id":"missing"})!="")
	print("PASS: physical switch toggles, potentiometer clamps at both endpoints, momentary button releases, missing controls rejected")
	quit()
