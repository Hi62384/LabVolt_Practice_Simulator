extends SceneTree
const Model=preload("res://scripts/campus/ac_laptops/model.gd")
func _initialize():
 var m=Model.new();var near=Model.CABINET+Vector3(0,1,0);var p=Vector3(-6,0,-1)
 assert(m.laptops.size()==6 and m.cables.size()==6)
 assert(m.apply(1,near,"cabinet")=="")
 assert(m.apply(1,near,"take_laptop",0)=="")
 assert(not m.apply(2,p,"place_laptop",-1,Vector3(-6,.8,-1)).is_empty())
 assert(not m.apply(1,p,"place_laptop",-1,Vector3.INF).is_empty())
 assert(not m.apply(1,p,"place_laptop",-1,Vector3(9,.8,-1)).is_empty())
 assert(m.laptops[0].where=="held" and m.laptops[0].owner==1)
 assert(m.apply(1,p,"place_laptop",-1,Vector3(-6,.8,-1))=="")
 assert(m.apply(1,p,"open",0)=="")
 assert(not m.apply(1,p,"pickup",0).is_empty())
 assert(m.apply(1,near,"take_cable",0)=="")
 assert(m.apply(1,p,"attach_laptop",0)=="")
 assert(m.apply(1,p,"attach_daq",-1,Vector3(-6,1,-2),1)=="")
 assert(m.cables[0].where=="connected" and m.cables[0].station==1)
 assert(m.apply(1,p,"close",0)=="")
 assert(m.apply(1,p,"pickup",0)=="")
 assert(m.laptops[0].where=="held" and m.cables[0].where=="connected")
 assert(not m.apply(1,p,"stow_laptop").is_empty())
 assert(m.apply(1,p,"place_laptop",-1,Vector3(-6,.8,-1))=="")
 assert(not Model.daq_powered({"powered":true,"cables":[]}))
 assert(Model.daq_powered({"powered":true,"cables":[{"a":"LOW_0","b":"DAQ_POWER_A"}]}))
 assert(not Model.daq_powered({"powered":false,"cables":[{"a":"LOW_0","b":"DAQ_POWER_A"}]}))
 assert(m.apply(1,p,"disconnect",0)=="")
 assert(m.apply(1,near,"store_cable")=="")
 assert(m.apply(1,p,"pickup",0)=="")
 assert(m.apply(1,near,"store_laptop")=="")
 assert(m.laptops[0].where=="cabinet" and m.cables[0].where=="cabinet")
 print("PASS AC laptop cabinet, placement, USB, power and return")
 quit()
