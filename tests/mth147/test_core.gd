extends SceneTree
const C = preload("res://scripts/mth147/math_core.gd")
const E = preload("res://scripts/mth147/exact.gd")
var checks: int=0
var failures: int=0
func expect(condition: bool,label: String) -> void:
	checks+=1
	if not condition:failures+=1;print("FAIL ",label)
func _initialize() -> void:
	for pair in [["1/2","2/4"],["(x+2)*(x-2)","x^2-4"],["(a+b)/a","1+b/a"],["sqrt(8)","2*sqrt(2)"],["sqrt(2)*sqrt(8)","4"],["1/sqrt(2)","sqrt(2)/2"],["root(3,54)","3*root(3,2)"],["sqrt(5+2*sqrt(6))","sqrt(2)+sqrt(3)"],["sin(x)^2+cos(x)^2","1"],["sec(x)^2-tan(x)^2","1"],["(1-cos(x)^2)/sin(x)","sin(x)"],["(x*y)^3","x^3*y^3"]]:
		expect(C.equivalent(pair[0],pair[1]).equivalent,"exact "+str(pair))
	for pair in [["x+1","x-1"],["sqrt(2)","1.41421356"],["(x+1)^2","x^2+1"],["sin(x)","cos(x)"]]:expect(not C.equivalent(pair[0],pair[1]).equivalent,"reject "+str(pair))
	expect(C.equivalent("root(4,4)","sqrt(2)").equivalent,"radical indices canonical")
	expect(C.equivalent("sqrt(2)*root(3,2)","2^(5/6)").equivalent,"mixed radical indices")
	for pair in [["sin(2*x)","2*sin(x)*cos(x)"],["cos(2*x)","cos(x)^2-sin(x)^2"],["sin(x+y)","sin(x)*cos(y)+cos(x)*sin(y)"],["sin(x-y)","sin(x)*cos(y)-cos(x)*sin(y)"],["cos(x+y)","cos(x)*cos(y)-sin(x)*sin(y)"],["sin(3*x)","3*sin(x)-4*sin(x)^3"],["cos(-x)","cos(x)"],["tan(2*x)","2*tan(x)/(1-tan(x)^2)"]]:
		expect(C.equivalent(pair[0],pair[1]).get("equivalent",false),"angle proof "+str(pair))
		for unit in ["degrees","radians"]:
			var a := C.evaluate(pair[0],{"x":0.37,"y":0.81},unit);var b := C.evaluate(pair[1],{"x":0.37,"y":0.81},unit)
			expect(a.ok and b.ok and absf(float(a.value)-float(b.value))<1e-10,"independent trig residual "+unit)
	expect(not C.equivalent("0^0","1").equivalent,"zero power undefined")
	expect(C.evaluate("(-8)^(1/3)").ok and absf(float(C.evaluate("(-8)^(1/3)").value)+2)<1e-12,"odd rational power real domain")
	for source in ["OS.execute(1)","load(1)","x[0]","x=1","foo(1)","__import__(1)","1;2","x".repeat(600),"(".repeat(30)+"1"+")".repeat(30),"sqrt(-1)","log(1,1)","ln(0)","atan2(0,0)","1/0","exp(1000)","10^101"]:expect(not C.evaluate(source).ok,"bounded reject "+source.left(30))
	expect(absf(float(C.evaluate("sin(pi/2)",{},"radians").value)-1)<1e-12,"radian context")
	expect(absf(float(C.evaluate("sin(90)").value)-1)<1e-12,"degree context")
	expect(absf(float(C.evaluate("atan2(1,-1)").value)-135)<1e-10,"atan2 order")
	expect(absf(float(C.evaluate("log(125,5)").value)-3)<1e-10,"log argument order")
	expect(C.evaluate("1e-80").ok and float(C.evaluate("1e-80").value)>0,"very small numeric")
	expect(C.evaluate("1e80").ok,"very large numeric")
	for input in ["1e-400","1e-101","exp(-1000)","1e-80*1e-80"]:expect(not C.evaluate(input).ok,"underflow fails closed "+input)
	expect(C.evaluate({"op":"num","value":"-3"}).ok,"signed AST numeric literal")
	expect(C.equivalent("α+β","beta+alpha").equivalent,"Greek symbols")
	expect(not C.input_ast({"op":"num","value":"1","unexpected":[1,2,3]}).ok,"unknown AST payload rejected")
	expect(not C.input_ast({"op":"num","value":{"op":"num","value":"1"}}).ok,"numeric AST value must be literal text")
	expect(C.evaluate(1.0/61000).ok and absf(float(C.evaluate(1.0/61000).value)*61000-1)<1e-12,"float serialization")
	expect(E.mul(E.q(1000000000000),E.q(1000000000000)).is_empty(),"exact overflow fails closed")
	expect(C.inspect_form("factored","(x+2)*(x-2)","(x-2)*(x+2)").ok,"factored order")
	expect(not C.inspect_form("factored","x^2-4","(x-2)*(x+2)").ok,"expanded not factored")
	expect(not C.inspect_form("expanded","(x+1)^2","x^2+2*x+1").ok,"factored not expanded")
	expect(not C.inspect_form("expanded","x+x","2*x").ok,"combine like terms")
	expect(not C.inspect_form("expanded","x*x","x^2").ok,"combine repeated bases")
	expect(not C.inspect_form("positive_exponents","x^-2","1/x^2").ok,"positive powers")
	expect(C.inspect_form("scientific","1.20e6","1200000").ok,"scientific representation")
	expect(not C.inspect_form("scientific","12e5","1200000").ok,"scientific mantissa")
	expect(C.inspect_form("engineering","12e6","12000000").ok,"engineering representation")
	expect(not C.inspect_form("engineering","1.2e7","12000000").ok,"engineering exponent")
	expect(C.inspect_form("significant","1.200e3","1200",{"digits":4}).ok,"significant zeros")
	expect(not C.inspect_form("radical","sqrt(8)","2*sqrt(2)").ok,"perfect power extraction")
	expect(not C.inspect_form("radical","1/sqrt(2)","sqrt(2)/2").ok,"rationalized required")
	expect(not C.inspect_form("radical","sqrt(2)*sqrt(3)","sqrt(6)").ok,"combine radical products")
	expect(not C.inspect_form("radical","root(4,4)","sqrt(2)").ok,"reduce radical index")
	expect(C.domain_constraints("(x-2)/(x-2)").constraints.size()==1,"original denominator retained")
	expect(not C.domain_at("(x-2)/(x-2)",{"x":2}).in_domain,"canceled hole excluded")
	print("CORE_CHECKS ",checks," FAILURES ",failures)
	quit(1 if failures else 0)
