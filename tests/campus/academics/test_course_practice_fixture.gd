extends SceneTree
const Practice=preload("res://scripts/campus/academics/classroom_events/practice_round.gd")
func _initialize() -> void:
 var exercise:=Practice.new()
 assert(not exercise.prepare(false,"event","DGS266",3,0,42,30.0,["alice"]))
 assert(exercise.prepare(true,"event","DGS266",3,0,42,30.0,["alice","bob"]))
 var public: Dictionary=exercise.snapshot("alice",1.0)
 assert(public.can_submit and not public.question.has("answer") and not public.question.has("explanation"))
 var answer: String=str(exercise.private_assignment.questions[exercise.question_index].answer)
 assert(exercise.submit(false,"alice","event",answer,1.0)=="closed")
 assert(exercise.submit(true,"alice","event",answer,1.0)=="accepted")
 assert(exercise.submit(true,"alice","event",answer,2.0)=="already_submitted")
 assert(exercise.disconnected(true,"bob"))
 assert(exercise.submit(true,"bob","event",answer,2.0)=="not_participating")
 assert(not exercise.rejoin(true,"observer",2.0) and exercise.rejoin(true,"bob",2.0))
 assert(exercise.submit(true,"bob","old-event",answer,2.0)=="not_participating")
 assert(exercise.submit(true,"bob","event",answer,30.0)=="closed")
 assert(exercise.result("alice").is_empty())
 assert(exercise.finish(true))
 assert(exercise.result("alice").correct and exercise.result("bob").is_empty())
 for course in ["ETY155","ELM253","MTH147","MTH255"]:
  var other:=Practice.new()
  assert(other.prepare(true,"event",course,1,0,42,30.0,["student"]))
  assert(not other.snapshot("student",0.0).question.has("answer"))
  assert(not other.snapshot("student",0.0).question.has("explanation"))
  assert(not Practice.has_private_fields(other.snapshot("student",0.0).question))
  var response: Variant={} if course=="MTH255" else "invalid response"
  assert(other.request_hint(false,"student","event",1.0)=="closed")
  assert(other.request_hint(true,"student","event",1.0)=="accepted")
  assert(other.request_hint(true,"student","event",1.1)=="already_used")
  assert(not other.snapshot("observer",1.0).has("hint"))
  assert(other.snapshot("student",1.0).has("hint") and not other.snapshot("student",1.0).has("result"))
  assert(other.submit(true,"student","event",response,1.0)=="retry")
  assert(other.snapshot("student",1.0).progress.attempts_left==1)
  assert(not other.snapshot("observer",1.0).has("progress"))
  assert(other.disconnected(true,"student"))
  assert(other.request_hint(true,"student","event",1.2)=="not_participating")
  assert(not other.snapshot("student",1.2).can_submit)
  assert(other.rejoin(true,"student",1.3) and other.snapshot("student",1.3).progress.attempts_left==1)
  assert(other.submit(true,"student","event",response,1.4)=="accepted")
  assert(other.result("student").is_empty() and other.finish(true))
  assert(not other.result("student").get("correct",true))
  assert(other.request_hint(true,"student","event",2.0)=="closed")
 assert(Practice.has_private_fields({"diagram":{"nested":[{"answer":12}]}}))
 var structured:=Practice.new()
 assert(structured.prepare(true,"structured","MTH255",1,0,42,30.0,["student"]))
 var expected: Variant=structured.private_assignment.questions[structured.question_index].answer.duplicate(true)
 assert(expected is Dictionary)
 assert(structured.submit(true,"student","structured",expected,1.0)=="accepted")
 assert(structured.finish(true) and structured.result("student").get("correct",false))
 var late:=Practice.new()
 assert(late.prepare(true,"late","DGS266",3,0,42,30.0,["student"]))
 assert(late.submit(true,"student","late","invalid response",26.0)=="accepted")
 assert(not late.snapshot("student",26.0).can_submit)
 var invalid:=Practice.new()
 assert(not invalid.prepare(true,"event","DGS266",999,0,42,30.0,["student"]))
 print("COURSE_PRACTICE_FIXTURE PASS");quit(0)
