extends SceneTree
const Player=preload("res://scripts/campus/academics/teacher_speech_player.gd")
const Mixer=preload("res://scripts/campus/voice/audio_voice_mixer.gd")
var finishes: Array=[]
func _initialize() -> void:call_deferred("run")
func run() -> void:
	var speech:=Player.new();root.add_child(speech);speech.set_process(false)
	var anchor:=Node3D.new();root.add_child(anchor)
	var wav:=AudioStreamWAV.new();wav.format=AudioStreamWAV.FORMAT_16_BITS;wav.mix_rate=16000
	var pcm:=PackedByteArray();pcm.resize(160000);wav.data=pcm
	speech.utterance_finished.connect(func(channel,serial,delivered):finishes.append([channel,serial,delivered]))
	var pending:={"expect_audio":true,"character_id":"teacher","delivery":{"projection":"lecture"}}
	assert(speech.accept("lecture","Teacher",1,"First teaching objective.",1,anchor,null,1.,pending))
	assert(not speech.subtitles.has("lecture") and speech.presentations.lecture.waiting,"Pending synthesis must not reveal unheard text.")
	assert(speech.accept("lecture","Teacher",2,"Second teaching objective.",1,anchor,null,1.,pending))
	assert(speech.accept("lecture","Teacher",3,"Final teaching objective.",1,anchor,null,1.,pending))
	assert(speech.deliver_stream("lecture",2,wav) and not speech.active.has("lecture"),"Out-of-order generation must not reorder teaching.")
	assert(speech.deliver_stream("lecture",1,wav) and speech.active.lecture.serial==1,"Earlier pending utterance remains deliverable after newer accepts.")
	assert(speech.active.lecture.player.bus==Mixer.NPC_BUS)
	assert(speech.active.lecture.player.unit_size==10.)
	var original_player: AudioStreamPlayer3D=speech.active.lecture.player
	original_player.seek(1.25)
	assert(speech.pause_for_interruption("lecture") and not original_player.playing)
	assert(speech.has_suspended("lecture") and speech.suspended.lecture.back().queued.size()==2)
	assert(speech.deliver_stream("lecture",3,wav),"Paused narration still accepts its pending audio.")
	assert(speech.accept("lecture","Teacher",4,"That variable is current in amperes.",3,anchor,wav,1.,pending))
	assert(not speech.resume_suspended("lecture"),"Resumption waits for the direct answer to finish.")
	speech._finished("lecture",4)
	assert(speech.active.lecture.serial==1 and speech.active.lecture.player==original_player)
	assert(not original_player.stream_paused and speech.queued.lecture.size()==2)
	speech._finished("lecture",1)
	assert(speech.active.lecture.serial==2)
	speech._finished("lecture",2)
	assert(speech.active.lecture.serial==3)
	speech._finished("lecture",3)
	assert(not speech.active.has("lecture") and not speech.has_suspended("lecture"))
	assert(finishes.map(func(item):return item[1])==[4,1,2,3],"Every teaching objective must be delivered exactly once after an interruption.")
	assert(speech.accept("failure","Teacher",1,"Readable when voice is unavailable.",1,anchor,null,1.,pending))
	assert(speech.fail_stream("failure",1,"provider unavailable") and speech.subtitles.has("failure"))
	assert(not speech.deliver_stream("failure",1,wav),"Failed/cancelled synthesis cannot later resurrect audio.")
	speech.cancel("failure")
	assert(speech.accept("cancel","Teacher",1,"Never play after leaving.",1,anchor,null,1.,pending))
	speech.cancel("cancel");assert(not speech.deliver_stream("cancel",1,wav))
	assert(speech.accept("off","Teacher",1,"Pause then disable speech.",1,anchor,wav,1.,pending))
	speech.pause_for_interruption("off");speech.configure(false,true);speech.resume_suspended("off")
	assert(not speech.active.has("off"),"Disabling speech must also mute suspended narration.")
	speech.clear_session();speech.queue_free();anchor.queue_free();await process_frame
	print("VOICE_PLAYBACK_LIFECYCLE PASS (ordered pending, captions, exact pause/resume, cancellation, mute)")
	quit()
