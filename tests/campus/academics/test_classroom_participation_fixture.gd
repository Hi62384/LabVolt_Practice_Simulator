extends SceneTree
const Participation=preload("res://scripts/campus/academics/classroom_events/hand_queue.gd")
func _initialize() -> void:
 var state:=Participation.new()
 assert(not state.begin(false,"event",["alice"]))
 assert(state.begin(true,"event",["alice","bob"]))
 assert(not state.set_hand(true,"old","alice",true))
 assert(not state.set_hand(true,"event","outsider",true))
 assert(state.set_hand(true,"event","alice",true))
 assert(state.set_hand(true,"event","alice",true))
 assert(state.set_hand(true,"event","bob",true))
 var view:=state.snapshot();view.hands.clear();assert(state.hands.size()==2)
 assert(state.call_next(true,"event")=="alice")
 assert(state.call_next(true,"event").is_empty())
 assert(state.disconnected(true,"alice") and state.selected.is_empty())
 assert(not state.set_hand(true,"event","alice",true))
 assert(not state.rejoined(true,"event","outsider"))
 assert(state.rejoined(true,"event","alice"))
 assert(state.set_hand(true,"event","alice",true))
 assert(state.call_next(true,"event")=="bob")
 assert(not state.call_student(true,"event","alice"))
 assert(state.finish_turn(true,"event"))
 assert(not state.call_student(false,"event","alice"))
 assert(not state.call_student(true,"event","outsider"))
 assert(state.call_student(true,"event","alice"))
 assert(state.selected=="alice" and state.hands.is_empty())
 assert(state.finish_turn(true,"event") and state.close(true,"event"))
 assert(not state.set_hand(true,"event","bob",true))
 print("CLASSROOM_PARTICIPATION_FIXTURE PASS");quit(0)
