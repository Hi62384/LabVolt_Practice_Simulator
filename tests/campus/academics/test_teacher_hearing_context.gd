extends SceneTree
const Brain=preload("res://scripts/campus/academics/teacher_brain.gd")
const Dialogue=preload("res://scripts/campus/academics/teacher_dialogue.gd")
func _initialize() -> void:
 assert(Brain.context_allows("voice_noise","assignment",.25))
 assert(Brain.context_allows("class_message","assignment",.25))
 assert(Brain.context_allows("voice_noise","lesson",.25))
 assert(not Brain.context_allows("voice_noise","",.25))
 assert(Brain.context_allows("voice_noise","",.8))
 assert(not Brain.context_allows("class_message","",.25))
 var brain:=Brain.new()
 var personality:={"focus":.5,"difficulty":.5,"talkativeness":1.0}
 var fresh:=Brain.new()
 assert(fresh.consider("apple","student","ambient_speech",.25,personality,1,0.0).get("intent","")=="chat")
 assert(brain.consider("apple","student","ambient_speech",.25,personality,100000,.9).is_empty())
 var reaction: Dictionary=brain.consider("apple","student","ambient_speech",.25,personality,100001,0.0)
 assert(reaction.get("intent","")=="chat")
 assert(brain.consider("apple","student","ambient_speech",.25,personality,100002,0.0).is_empty())
 assert(brain.relationship("apple","student").disruptions==0)
 assert(brain.incidents.is_empty() and is_zero_approx(brain.teachers.apple.frustration))
 var mild: Dictionary=Brain.new().consider("bill_nye","student","voice_noise",.2,personality,100000,0.0)
 var loud: Dictionary=Brain.new().consider("bill_nye","student","voice_noise",.95,personality,100000,0.0)
 assert(mild.get("level","")=="calm" and loud.get("level","")=="firm")
 var quiet_reply: String=Dialogue.respond("bill_nye","noise",{"level":mild.level},0)
 var loud_reply: String=Dialogue.respond("bill_nye","noise",{"level":loud.level},0)
 assert(quiet_reply!=loud_reply and loud_reply.contains("too loud"))
 var exam_quiet: String=Dialogue.respond("bill_nye","noise",{"phase":"assignment","level":"calm"},0)
 var exam_loud: String=Dialogue.respond("bill_nye","noise",{"phase":"assignment","level":"firm"},0)
 var exam_message: String=Dialogue.respond("bill_nye","class_message",{"phase":"assignment"},0)
 assert(exam_quiet.contains("assessment") and exam_loud.contains("assessment"))
 assert(exam_message.contains("assessment"))
 assert(Brain.new().consider("bill_nye","exam_student","class_message",.45,personality,100000,0.0).get("intent","")=="class_message")
 var shared:=Brain.new()
 assert(shared.consider("bill_nye","student_a","voice_noise",1.0,personality,100000,0.0).get("intent","")=="noise")
 assert(shared.consider("bill_nye","student_a","voice_noise",1.0,personality,103000,0.0).is_empty())
 assert(shared.consider("bill_nye","student_b","voice_noise",1.0,personality,103000,0.0).get("intent","")=="noise")
 assert(shared.consider("bill_nye","student_c","voice_noise",1.0,personality,103001,0.0).is_empty())
 var bounded:=Brain.new()
 for i in Brain.MAX_INCIDENT_KEYS:
  bounded.incidents["bill_nye:old_%d"%i]={"count":1,"last":i,"kind":"voice_noise"}
 for i in Brain.MAX_REACTION_KEYS:
  bounded.reaction_times["bill_nye:old_%d"%i]=i
 assert(bounded.consider("bill_nye","new_student","voice_noise",1.0,personality,100000,0.0).get("intent","")=="noise")
 assert(bounded.incidents.size()==Brain.MAX_INCIDENT_KEYS and not bounded.incidents.has("bill_nye:old_0"))
 assert(bounded.reaction_times.size()==Brain.MAX_REACTION_KEYS and not bounded.reaction_times.has("bill_nye:old_0"))
 print("TEACHER_HEARING_CONTEXT PASS");quit(0)
