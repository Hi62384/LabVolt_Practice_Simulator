extends SceneTree
const CandidateView=preload("res://scripts/campus/academics/classroom_events/view.gd")
var calls:=[]
func _initialize() -> void:
 var view:=CandidateView.new();root.add_child(view)
 view.action_requested.connect(func(class_id,event_id,op,payload):calls.append([class_id,event_id,op,payload]))
 var state:={"class_id":"class-1","event_id":"event-1","course":"DGS266","question":{"prompt":"Choose","options":["A","B"]},"can_submit":true,"seconds_left":20.0}
 view.apply(state);assert(is_instance_valid(view.panel))
 view.panel.options.select(1);view.panel._submit()
 assert(calls==[["class-1","event-1","submit","1"]])
 view.apply(state)
 assert(view.panel.submit_button.disabled)
 view.panel._submit()
 assert(calls.size()==1)
 view.panel.hand_button.set_pressed(true)
 assert(calls.back()==["class-1","event-1","hand",true])
 view.action_status("class-1","event-1","submit","invalid")
 assert(not view.panel.submit_button.disabled and view.panel.status_label.text.contains("invalid"))
 view.panel._submit()
 view.action_status("class-1","event-1","submit","accepted")
 view.apply(state)
 assert(view.panel.submit_button.disabled)
 state.can_submit=false;view.apply(state);assert(view.panel.submit_button.disabled)
 state.hands={"selected":true};view.apply(state);assert(view.panel.hand_label.text.contains("called"))
 state.result={"correct":true,"reason":"Well done"};view.apply(state)
 assert(view.panel.status_label.text.contains("Correct") and view.panel.status_label.text.contains("Well done"))
 state.mode="quiz";state.round_number=2;state.rounds_total=3;state.personal_points=306;state.streak=2
 state.leaderboard=[{"name":"Student 1","points":306}];state.team_scores={"A":306,"B":0}
 state.result.points=148;state.totals={"correct":1,"answered":2,"total_points":148};view.apply(state)
 assert(view.panel.status_label.text.contains("148 points") and view.panel.status_label.text.contains("148 total points"))
 assert(view.panel.title_label.text.contains("Round 2 of 3") and view.panel.status_label.text.contains("Student 1 306"))
 view.panel.dismissed.emit();view.apply(state);assert(not view.panel.visible and view.reopen_hint.visible)
 assert(view.reopen() and view.panel.visible and not view.reopen_hint.visible)
 assert(view.panel.status_label.text.contains("Correct"))
 view.panel.dismissed.emit()
 var replacement:=state.duplicate(true);replacement.event_id="event-2";replacement.erase("result")
 replacement.can_submit=true;view.apply(replacement)
 assert(view.panel.visible and not view.reopen_hint.visible and not view.reopen())
 replacement.mode="group";replacement.closed=false
 replacement.shared={"group":"A","task":"Solve and check the method.","count":1,"contributed":false,"entries":[{"text":"A useful note"}],"proposal":"A useful note","agree":0,"disagree":0,"vote":null}
 view.apply(replacement)
 assert(view.panel.contribution_entry.visible and view.panel.shared_notes.text.contains("A useful note"))
 assert(view.panel.prompt_label.text.contains("Team A") and view.panel.vote_label.visible)
 view.panel.agree_button.pressed.emit()
 assert(calls.back()==["class-1","event-2","vote",true])
 replacement.shared.agree=1;replacement.shared.vote=true;view.apply(replacement)
 assert(view.panel.agree_button.disabled and not view.panel.disagree_button.disabled)
 view.panel.contribution_entry.text="Another note";view.panel.contribution_button.pressed.emit()
 assert(calls.back()==["class-1","event-2","contribute","Another note"])
 replacement.shared.contributed=true;view.apply(replacement)
 assert(view.panel.contribution_button.disabled)
 view.panel.dismissed.emit()
 view.apply({});assert(view.active_id.is_empty() and view.panel==null)
 assert(not view.reopen() and not view.reopen_hint.visible)
 print("CLASSROOM_CANDIDATE_VIEW PASS");quit(0)
