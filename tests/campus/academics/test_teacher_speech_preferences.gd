extends SceneTree
const Prefs=preload("res://scripts/campus/ui/client_preferences.gd")
const Player=preload("res://scripts/campus/academics/teacher_speech_player.gd")
func _initialize() -> void:call_deferred("run")
func run() -> void:
	var prefs=Prefs.new()
	prefs.values.teacher_speech=false;prefs.values.teacher_subtitles=false
	assert(prefs.save()==OK)
	var owner:=Node.new();root.add_child(owner)
	var loaded=Prefs.new();loaded.load_settings(owner)
	assert(not loaded.values.teacher_speech and not loaded.values.teacher_subtitles)
	assert(loaded.values.teacher_mic_detection)
	var player:=Player.new();root.add_child(player)
	var anchor:=Node3D.new();root.add_child(anchor)
	player.configure(false,true)
	assert(player.accept("ac_lab","Teacher",1,"Written reply",1,anchor))
	assert(player.subtitles.has("ac_lab") and player.active.is_empty())
	player.configure(true,false)
	assert(player.subtitles.is_empty())
	assert(player.accept("ac_lab","Teacher",2,"Second reply",1,anchor))
	var wav:=AudioStreamWAV.new();wav.format=AudioStreamWAV.FORMAT_16_BITS;wav.mix_rate=16000;wav.data=PackedByteArray([0,0,100,0])
	assert(player.deliver_stream("ac_lab",2,wav))
	assert(player.active.has("ac_lab") and player.subtitles.is_empty())
	player.configure(false,false)
	assert(player.active.is_empty())
	owner.queue_free();anchor.queue_free();player.queue_free()
	print("TEACHER_SPEECH_PREFERENCES PASS")
	quit()
