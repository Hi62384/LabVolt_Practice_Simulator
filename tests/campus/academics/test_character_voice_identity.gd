extends SceneTree
const Voices=preload("res://scripts/campus/academics/teacher_voice_profiles.gd")
const People=preload("res://scripts/campus/academics/class_character_profile.gd")
const Delivery=preload("res://scripts/campus/academics/character_voice_delivery.gd")
const Roster=preload("res://scripts/campus/academics/faculty_roster.gd")
var failures: Array[String]=[]

func check(condition: bool,message: String) -> void:
	if not condition:failures.append(message);push_error(message)

func _initialize() -> void:
	Voices.store_path="user://voice-identity-test-%d.json"%Time.get_ticks_usec()
	Voices.reset_cache()
	var authored:=Voices.designs()
	check(authored.size()==Roster.PEOPLE.size(),"Every established person has an authored original voice design")
	for id: String in Roster.PEOPLE:
		var person:=People.teacher(id)
		var modern:=People.speech(person,"gpt-realtime-2.1-mini",2)
		var live:=People.speech(person,"gpt-live-1.1",2)
		var legacy:=People.speech(person,"gpt-4o-mini-tts",2)
		check(bool(modern.get("ok",false)) and bool(live.get("ok",false)) and bool(legacy.get("ok",false)),"Authored preset fits all expressive models: "+id)
		check(modern.get("voice")==live.get("voice") and modern.get("voice")==legacy.get("voice"),"Changing compatible model never reassigns voice: "+id)
		check(modern.get("approval_status")=="provisional_preset","Shipped preset has not been falsely marked auditioned: "+id)
		check(not person.has("voice_slot"),"Roster position is not part of vocal identity: "+id)
	var bro:=People.teacher("mr_bro")
	var bro_voice:=Voices.identity(bro)
	check(bro_voice.vocal_presentation=="masculine" and "deep" in bro_voice.pitch_range,"Mr Bro has a designed deep masculine identity")
	var volts:=People.teacher("dr_volts")
	var bright:=People.speech(volts,"gpt-live-1.1",2,"excited",{"excitement":.9,"sadness":.05,"tiredness":.05})
	var subdued:=People.speech(volts,"gpt-live-1.1",2,"sad",{"excitement":.9,"sadness":.85,"tiredness":.35})
	check(bright.voice==subdued.voice and float(subdued.energy)<float(bright.energy)*.5,"Volts loses enthusiasm while remaining the same person")
	check(float(subdued.speed)<float(bright.speed) and "override habitual excitement" in subdued.instructions,"Sadness changes performed delivery rather than playback pitch")
	var brian:=People.teacher("brian")
	var mild:=People.speech(brian,"gpt-live-1.1",2,"irritated",{"anger":.1,"irritation":.3})
	var furious:=People.speech(brian,"gpt-live-1.1",2,"angry",{"anger":.95,"irritation":.9})
	check("Slight irritation" in mild.instructions and "Extreme anger" in furious.instructions,"Anger intensities have distinct performance direction")
	check(mild.voice==furious.voice and mild.delivery_key!=furious.delivery_key,"Emotional cache entries preserve speaker and differ in performance")
	var stone:=People.speech(People.teacher("mr_stone"),"gpt-live-1.1",2,"angry",{"anger":.95})
	check(stone.projection!="shout" and "deliberate control" in stone.instructions,"Disciplined anger differs from an impulsive character")
	var shy:=People.speech(People.teacher("mr_allu"),"gpt-live-1.1",2)
	check(shy.projection=="normal" and "ordinary audible speech" in shy.instructions,"Shyness never forces inaudible permanent speech")
	var student:=People.student(9)
	var saved:=Voices.identity(student)
	student.traits.warmth=1.-float(student.traits.warmth)
	check(Voices.identity(student)==saved,"Persistent student identity survives mood or trait evolution")
	var steps:=Delivery.segments(volts,"gpt-live-1.1","First we inspect this circuit. Then we discover an unexpected result.",2,"steady",{},[{"phrase":0,"mood":"confused","emotions":{"confusion":.7}}])
	check(not steps.is_empty() and steps[0].delivery.mood=="confused","Phrase delivery can use an authoritative emotional transition")
	check(Voices.stage_candidate(bro,{"id":"voice_test_bro","type":"prompt","prompt":bro_voice.design_description})==OK,"New custom voice stages successfully")
	check(Voices.identity(bro).permanent_voice_id==bro_voice.permanent_voice_id,"Generating a preview never replaces the permanent voice")
	check(Voices.approve("mr_bro","voice_test_bro",true)==ERR_UNAUTHORIZED,"Unheard custom voices cannot be approved")
	for mood: String in ["normal","sad","angry"]:check(Voices.record_audition("mr_bro","voice_test_bro",mood)==OK,"Record completed preview "+mood)
	check(Voices.approve("mr_bro","voice_test_bro",false)==ERR_UNAUTHORIZED,"Auditions alone do not assert character quality")
	check(Voices.approve("mr_bro","voice_test_bro",true,"gpt-live-1.1")==OK,"Explicit host assessment approves the auditioned voice and compatible model")
	Voices.reset_cache()
	var permanent:=People.speech(bro,"gpt-live-1.1",2,"sad",{"sadness":.8})
	check(permanent.get("voice")=={"id":"voice_test_bro"} and int(permanent.profile_version)==2,"Approved custom voice survives a fresh store load")
	var pinned:=People.speech(bro,"gpt-realtime-2.1-mini",2)
	check(pinned.model=="gpt-live-1.1" and pinned.voice==permanent.voice,"Explicitly approved character model stays pinned when the global default changes")
	var wrong_endpoint:=Voices.resolve(bro,"gpt-realtime-2.1-mini",Voices.identity(bro))
	check(not bool(wrong_endpoint.ok) and wrong_endpoint.voice==permanent.voice,"Prompt voices are blocked on incompatible endpoints instead of remapped")
	check(Voices.stage_candidate(brian,{"id":"voice_test_bro","type":"prompt"})==ERR_ALREADY_EXISTS,"Different established teachers cannot acquire the same custom identity accidentally")
	check(Voices.set_external_voice_count(80)==OK,"External organization allocation can be accounted for")
	check(not bool(Voices.capacity(student).available) and bool(Voices.capacity(brian).available),"Remaining organization capacity prioritizes established faculty")
	check(Voices.stage_candidate(brian,{"id":"voice_test_brian","type":"prompt"})==OK,"Second original voice can be staged")
	check(Voices.discard_candidate("brian")==OK and int(Voices.capacity(brian).known)==2,"Discarding a local candidate never silently deletes or frees remote quota")
	var path:=Voices.store_path
	for suffix: String in ["",".bak"]:
		var file:=FileAccess.open(path+suffix,FileAccess.WRITE);file.store_string("broken");file.close()
	Voices.reset_cache()
	check(Voices.identity(bro).is_empty() and Voices.last_error==ERR_FILE_CORRUPT,"Damaged voice persistence fails closed instead of replacing a custom voice")
	check(FileAccess.get_file_as_string(path)=="broken","Corrupt voice evidence is preserved")
	for suffix: String in ["",".bak",".tmp"]:
		if FileAccess.file_exists(path+suffix):DirAccess.remove_absolute(path+suffix)
	Voices.store_path="user://character_voices.json";Voices.reset_cache()
	print("CHARACTER_VOICE_IDENTITY ","PASS" if failures.is_empty() else "FAIL", " (authored identity, affect, approval, capacity and restart; no live listening claim)")
	quit(0 if failures.is_empty() else 1)
