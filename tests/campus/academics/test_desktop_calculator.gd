extends SceneTree
class FakeSession extends Node:
 signal desktop_changed(snapshot: Dictionary)
 signal operation_failed(message: String)
func _initialize():call_deferred("run")
func run():
 var session=FakeSession.new();root.add_child(session)
 var desktop=preload("res://scripts/campus/computers/desktop_ui.gd").new();root.add_child(desktop);desktop.build(session)
 desktop._switch_app("Calculator")
 var calc=desktop.content.get_child(0)
 assert(calc.model=="calculator")
 calc.display.text="2+3"
 calc.evaluate()
 assert(calc.result.text.contains("5"))
 var root_keys: Array[Node] = calc.find_children("*","Button",true,false).filter(func(button):return button.text=="ⁿ√")
 assert(root_keys.size()==1)
 calc.press("AC")
 calc.press("2")
 calc.press("7")
 root_keys[0].pressed.emit()
 calc.press("3")
 calc.press("=")
 assert(is_equal_approx(calc.answer,3.0))
 assert(not calc.display is LineEdit and calc.display.plan.commands.any(func(command):return command.get("text")=="√"))
 calc.press("AC")
 for key in ["3","÷","4","→","+","2","="]:calc.press(key)
 assert(is_equal_approx(calc.answer,2.75))
 assert(calc.display.plan.commands.any(func(command):return command.kind=="line"))
 print("PASS desktop calculator app")
 desktop.queue_free();session.queue_free();await process_frame
 quit()
