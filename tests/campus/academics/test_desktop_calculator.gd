extends SceneTree
class FakeSession extends Node:
 signal desktop_changed(snapshot: Dictionary)
 signal operation_failed(message: String)
func _initialize():call_deferred("run")
func run():
 var session=FakeSession.new();root.add_child(session)
 var desktop=preload("res://scripts/campus/computers/desktop_ui.gd").new();root.add_child(desktop);desktop.build(session)
 desktop._switch_app("Calculator")
 var calc=desktop.content.get_child(0)
 assert(calc.model=="calculator")
 calc.display.text="2+3"
 calc.evaluate()
 assert(calc.result.text.contains("5"))
 var root_keys: Array[Node] = calc.find_children("*","Button",true,false).filter(func(button):return button.text=="ⁿ√")
 assert(root_keys.size()==1)
 calc.press("AC")
 calc.press("2")
 calc.press("7")
 root_keys[0].pressed.emit()
 calc.press("3")
 calc.press("RUN")
 assert(is_equal_approx(calc.answer,3.0))
 assert(not calc.display is LineEdit and calc.display.plan.commands.any(func(command):return command.kind=="polyline"))
 assert(not calc.display.highlight_empty_caret)
 calc.press("AC")
 for key in ["ⁿ√","3","→","2","7","RUN"]:calc.press(key)
 assert(is_equal_approx(calc.answer,3.0))
 calc.press("↑")
 assert(calc.display.path.back().key=="right")
 calc.press("↓")
 assert(calc.display.path.back().key=="left")
 calc.press("AC")
 for key in ["3","÷","4","→","+","2","RUN"]:calc.press(key)
 assert(is_equal_approx(calc.answer,2.75))
 assert(calc.display.plan.commands.any(func(command):return command.kind=="line"))
 calc.display.text="7+1/2"
 calc.display.restore_caret({"trail":[{"index":2,"key":"right"}],"index":0})
 var up: Button=calc.find_children("*","Button",true,false).filter(func(button):return button.text=="↑")[0]
 up.pressed.emit()
 assert(calc.display.path.back().key=="left")
 calc.press("↓")
 assert(calc.display.path.back().key=="right")
 calc.display.restore_caret({"trail":[],"index":2})
 calc.press("DEL")
 assert(calc.display.text=="7+")
 calc.press("AC")
 for key in ["sin","3","0","°","RUN"]:calc.press(key)
 assert(is_equal_approx(calc.answer,0.5))
 calc.display.text="sin(30)"
 calc.press("RUN")
 assert(is_equal_approx(calc.answer,sin(30.0)))
 calc.press("AC")
 calc.press("π")
 assert(calc.display.text=="π")
 calc.press("AC")
 for key in ["5","x","+","4","Equality","2","x","RUN"]:calc.press(key)
 assert(calc.result.text.begins_with("x = -1.333"))
 calc.display.text="y^2=4"
 calc.press("RUN")
 assert(calc.result.text=="y = -2, 2")
 calc.display.text="x+y=6"
 calc._refresh_isolation()
 assert(calc.isolate_picker.visible and calc.isolate_picker.item_count==2)
 calc.isolate_picker.select(1)
 calc.press("RUN")
 assert(calc.result.text=="y = -x + 6")
 calc.display.text="x^2+x^2"
 calc.press("RUN")
 assert(calc.result.text=="2x^2")
 calc.display.text="3/x+x/7"
 calc.press("RUN")
 assert(calc.result.text=="(x^2 + 21)/(7x)")
 assert(calc.result_equation.plan.commands.any(func(command):return command.get("text","")=="𝑥"))
 calc.display.text="x*7"
 assert(calc.display.plan.commands.any(func(command):return command.get("text","")=="×"))
 calc.display.text="x/(x-x)"
 calc.press("RUN")
 assert(calc.result.text=="Cannot divide by zero.")
 var narrow:=preload("res://scripts/campus/items/calculator_equation_view.gd").new()
 root.add_child(narrow)
 narrow.set_expression("(123456789x^2 + 987654321x + 111111111)/(123456789x^2 + 42)")
 narrow.size.x=100
 assert(narrow.plan.size.x>narrow.size.x and narrow._draw_scale()<1.0)
 assert(narrow.plan.size.x*narrow._draw_scale()<=narrow.size.x)
 narrow.queue_free()
 calc.press("AC")
 calc.press("Ans")
 assert("x" in calc.display.text and "^" in calc.display.text)
 calc.press("RUN")
 assert(calc.result.text=="(x^2 + 21)/(7x)")
 calc.display.text="x^2"
 calc.press("∫")
 assert(calc.result.text=="x^3/3")
 calc.press("d/dx")
 assert(calc.result.text=="2x")
 calc.display.text="x^2-9"
 calc.press("Factor")
 assert("(x + 3)" in calc.result.text and "(x - 3)" in calc.result.text)
 calc.display.text="3+4i"
 calc.press("Convert")
 assert(calc.result.text.begins_with("5 ∠ "))
 calc.display.text="2∠90°"
 calc.press("Convert")
 assert(calc.result.text=="2i")
 calc.display.text="85i+300-65i"
 calc.press("x²")
 calc.press("RUN")
 assert(calc.result.text=="365 + 85i")
 calc.display.text="85i+300-(65i)"
 calc.press("x²")
 calc.press("RUN")
 assert(calc.result.text=="4525 + 85i")
 calc.display.text="65"
 calc.press("x²")
 calc.press("RUN")
 assert(is_equal_approx(calc.answer,4225.0))
 calc.display.text="sin(30°)"
 calc.press("x²")
 calc.press("RUN")
 assert(is_equal_approx(calc.answer,0.25))
 calc.display.text="7+2^3"
 calc.display.restore_caret({"trail":[{"index":2,"key":"left"}],"index":0})
 calc.press("DEL")
 assert(calc.display.text=="7+")
 print("PASS desktop calculator app")
 desktop.queue_free();session.queue_free();await process_frame
 quit()
