extends SceneTree
const Profiles = preload("res://scripts/campus/academics/class_character_profile.gd")
const Dossier = preload("res://scripts/campus/academics/character_dossier.gd")
const Store = preload("res://scripts/campus/academics/character_dossier_store.gd")
const Generation = preload("res://scripts/campus/academics/character_dossier_generation.gd")
const Population = preload("res://scripts/campus/academics/student_population.gd")
var failures: Array[String] = []
func _initialize() -> void:
	call_deferred("run")
func check(value: bool, message: String) -> void:
	if not value: failures.append(message); push_error(message)
func run() -> void:
	check(Store.set_host_profile("dossier-test-"+str(Time.get_ticks_usec()))==OK,"host binding")
	var bro:=Profiles.teacher("mr_bro")
	check(float(bro.traits.teaching_effort)<.4,"Bro should prefer socializing to teaching")
	check(float(bro.traits.slang)>.8 and float(bro.traits.arrogance)>.5,"Bro intended identity")
	check(not bro.biography.has("bench_press_pr"),"fresh Bro must not receive hardcoded bench record")
	check(bro.dossier_status=="needs_expansion","legacy data must not masquerade as AI completion")
	check(Profiles.teacher("chad").traits.empathy<.3,"Chad preserves dismissiveness")
	check(Profiles.teacher("stanley").traits.teaching_effort<.15,"Stanley preserves disengagement")
	var person:=bro.duplicate(true)
	person.dossier=Store.get_dossier("mr_bro")
	person.dossier.life_history.append({"id":"training_record","title":"Old lifting log","text":"He trained the bench press at the garage gym. His personal best had been a long project with his friend Ellis. They celebrated after a year of regular training.","topics":["bench press","strength_record","training"],"entities":["Ellis","garage gym"],"chronology":"Before the campus story","source":"improvised_fiction"})
	for question in ["What's your bench PR?","How much can you bench?","What did you get on bench?","What's the most you've ever benched?"]:
		var retrieved:=Dossier.retrieve(person,question)
		check("training_record" in retrieved.diagnostics.section_ids,"semantic retrieval: "+question)
	var followup:=Dossier.retrieve(person,"Who were you training with?",[{"question":"What is your bench record?","reply":"I trained at the garage gym."}])
	check("training_record" in followup.diagnostics.section_ids,"follow-up uses real conversation topics")
	Store.preserve_biography("mr_bro",{"old_record":"An existing save established a personal record."})
	check(Store.save()==OK,"migration save")
	var original:=Store.get_dossier("mr_bro")
	var owner:=Store.host_identity
	check(Store.set_host_profile(owner+"-other")==OK,"switch owners")
	check(Store.get_dossier("mr_bro").is_empty(),"host privacy")
	check(Store.set_host_profile(owner)==OK,"restore owner")
	check(Store.get_dossier("mr_bro").established_biography.old_record==original.established_biography.old_record,"restart preserves established history")
	var population:=Population.new()
	check(population.set_host_profile(owner+"-fresh")==OK,"fresh population binding")
	population.load_population()
	population.ensure_size(24)
	check(population.people.is_empty(),"offline fresh population does not silently synthesize generic students")
	check(population.available({},6,42).is_empty(),"class start remains nonblocking with empty reserve")
	check(population.requested_size==24,"reserve generation demand")
	var invalid:=Dossier.validate({"identity":{}})
	check(not invalid.ok,"malformed generated dossier rejected")
	check(Generation.decode("{invalid") == null,"incomplete JSON rejected")
	if failures.is_empty():print("DOSSIER_SCHEMA PASS")
	else: print("DOSSIER_SCHEMA FAIL "+str(failures))
	quit(0 if failures.is_empty() else 1)
