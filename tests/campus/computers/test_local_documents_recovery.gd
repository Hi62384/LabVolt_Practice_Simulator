extends SceneTree
const Documents=preload("res://scripts/campus/computers/local_documents.gd")
const Files=preload("res://scripts/campus/computers/virtual_files.gd")
const Sessions=preload("res://scripts/campus/computers/computer_sessions.gd")

func _write(path: String,text: String) -> void:
	var file:=FileAccess.open(path,FileAccess.WRITE)
	assert(file!=null)
	file.store_string(text)
	file.close()

func _initialize() -> void:
	var nonce:=str(Time.get_ticks_usec())
	var owner:=nonce.sha256_text().left(48)
	var other:=(nonce+"other").sha256_text().left(48)
	var target:=Documents.location(owner)
	var other_target:=Documents.location(other)
	var files:={"notes.txt":{"text":"study notes","version":1}}
	assert(Documents.load_state("bad-profile").status=="error")
	assert(Documents.load_state(owner).status=="missing")
	assert(Documents.load_state(other).status=="missing")
	assert(Documents.save_documents(owner,files,{"path":"notes.txt","cursor":5})==OK)
	var good:=Documents.load_state(owner)
	assert(good.status=="ok" and good.files==files and good.editor.cursor==5)
	assert(Documents.load_state(other).status=="missing")
	assert(Documents.save_documents(owner,files,{"path":"missing.txt","cursor":0})==ERR_INVALID_DATA)
	_write(target,JSON.stringify({"files":files,"editor":{"path":"../bad","cursor":999}}))
	assert(Documents.load_state(owner).status=="ok" and Documents.load_state(owner).editor.is_empty())
	_write(target,JSON.stringify({"files":files,"editor":{"path":"notes.txt","cursor":99}}))
	assert(Documents.load_state(owner).editor.is_empty())
	_write(target,JSON.stringify({"files":files,"editor":{"path":"notes.txt","cursor":-1}}))
	assert(Documents.load_state(owner).editor.is_empty())
	_write(target,JSON.stringify({"files":files,"editor":{"path":"notes.txt","cursor":1.5}}))
	assert(Documents.load_state(owner).editor.is_empty())
	_write(target,JSON.stringify({"files":{"../escape":{"text":"x","version":1}}}))
	assert(Documents.load_state(owner).status=="error")
	_write(target,"{damaged")
	assert(Documents.load_state(owner).status=="error")
	var session:=Sessions.new()
	session.local_profile=owner
	var failed_notice:=[0]
	session.operation_failed.connect(func(_message: String):failed_notice[0]+=1)
	var pending:={"lease":1,"revision":0,"restored":false,"files":{},"editor":{}}
	session._receive(pending)
	assert(session.local_snapshot.has("local_error") and failed_notice[0]==1)
	session._receive(pending)
	assert(session.local_snapshot.has("local_error") and failed_notice[0]==1)
	session.free()
	assert(Documents.save_documents(owner,files)==ERR_FILE_CORRUPT)
	assert(FileAccess.get_file_as_string(target)=="{damaged")
	_write(target,JSON.stringify({"files":{"notes.txt":{"text":"x","version":1.5}}}))
	assert(Documents.load_state(owner).status=="error")
	_write(target,JSON.stringify({"files":{"notes.txt":{"text":"x","version":0}}}))
	assert(Documents.load_state(owner).status=="error")
	_write(target," ".repeat(Documents.MAX_SAVE_BYTES+1))
	assert(Documents.load_state(owner).status=="error")
	assert(Documents.load_state(other).status=="missing")
	assert(DirAccess.remove_absolute(target)==OK)
	var tmp_dir:=ProjectSettings.globalize_path(target+".tmp")
	assert(DirAccess.make_dir_absolute(tmp_dir)==OK)
	assert(Documents.save_documents(owner,files)!=OK)
	assert(Documents.load_state(owner).status=="missing")
	var retry_session:=Sessions.new()
	retry_session.local_profile=owner
	retry_session._receive({"lease":2,"revision":1,"restored":true,"public_device":false,"files":files,"editor":{}})
	assert(retry_session.local_snapshot.has("local_error") and retry_session.local_snapshot.files==files)
	assert(DirAccess.remove_absolute(tmp_dir)==OK)
	retry_session.retry_local_documents()
	assert(not retry_session.local_snapshot.has("local_error") and Documents.load_state(owner).files==files)
	retry_session.free()
	assert(DirAccess.remove_absolute(target)==OK)
	var target_dir:=ProjectSettings.globalize_path(target)
	assert(DirAccess.make_dir_absolute(target_dir)==OK)
	assert(Documents.save_documents(owner,files)!=OK)
	assert(DirAccess.remove_absolute(target_dir)==OK)
	assert(Documents.save_documents(owner,files)==OK)
	assert(Documents.load_state(owner).files==files)
	assert(Documents.save_documents(owner,{"notes.txt":{"text":"revised","version":2}})==OK)
	assert(Documents.load_state(owner).files["notes.txt"].text=="revised")
	assert(FileAccess.file_exists(target+".bak"))
	assert(JSON.parse_string(FileAccess.get_file_as_string(target+".bak")).files["notes.txt"].text=="study notes")
	assert(Files.validate(Documents.load_state(owner).files))
	DirAccess.remove_absolute(target)
	DirAccess.remove_absolute(target+".bak")
	DirAccess.remove_absolute(target+".tmp")
	DirAccess.remove_absolute(other_target)
	print("LOCAL_DOCUMENTS_RECOVERY PASS")
	quit(0)
