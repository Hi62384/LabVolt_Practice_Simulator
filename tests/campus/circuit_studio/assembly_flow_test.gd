extends SceneTree
const Model=preload("res://scripts/campus/facilities/circuit_studio/assembly_model.gd")
const Profile=preload("res://scripts/electronics_profile.gd")
const Ledger=preload("res://scripts/inventory_authority/ledger.gd")

func _initialize() -> void:call_deferred("_run")

func _run() -> void:
	var p:=Profile.new()
	var identity:=Crypto.new().generate_random_bytes(12).hex_encode()
	p.open(identity)
	var drive:=Model.empty("Drive base")
	drive.parts.append({"type":"battery","x":1,"y":0,"z":0,"control":"","ref":""})
	drive.parts.append({"type":"dc_motor","x":0,"y":1,"z":0,"control":"A","ref":""})
	drive.parts.append({"type":"wheel","x":1,"y":1,"z":0,"control":"","ref":""})
	drive.parts.append({"type":"switch","x":2,"y":0,"z":0,"control":"A","ref":""})
	var shell:=Model.empty("Powered cart")
	shell.parts.append({"type":"nested","x":1,"y":0,"z":0,"control":"","ref":"inv:drive"})
	p.data.inventions={"inv:drive":drive,"inv:cart":shell}
	assert(Model.validate("inv:cart",p.data.inventions,p.data.get("blueprints",{}))=="")
	assert(Model.price("inv:cart",p.data.inventions,p.data.get("blueprints",{}))==73)
	var module: Dictionary=Model.empty("Power module")
	module.parts.append({"type":"battery","x":1,"y":0,"z":0,"control":"","ref":""})
	module.parts.append({"type":"switch","x":2,"y":0,"z":0,"control":"A","ref":""})
	var modular: Dictionary=Model.empty("Modular servo")
	modular.parts.append({"type":"nested","x":0,"y":0,"z":1,"control":"","ref":"inv:power_module"})
	modular.parts.append({"type":"servo","x":0,"y":1,"z":0,"control":"A","ref":""})
	var modular_designs: Dictionary={"inv:power_module":module,"inv:modular":modular}
	assert(Model.validate("inv:power_module",modular_designs,{})=="")
	assert(Model.validate("inv:modular",modular_designs,{})=="","Nested batteries and switches must power a parent actuator")
	assert(Model.flattened("inv:modular",modular_designs,{}).size()==5)
	assert(Model.flattened("inv:cart",p.data.inventions,p.data.get("blueprints",{})).size()==6)
	var rotated: Dictionary=p.data.inventions.duplicate(true)
	rotated["inv:cart"].parts[1].turns=1
	var rotated_parts:=Model.flattened("inv:cart",rotated,p.data.get("blueprints",{}))
	assert(rotated_parts.size()==6)
	Model.connect_wheels(rotated_parts)
	var rotated_wheel: Dictionary=rotated_parts.filter(func(part):return part.type=="wheel")[0]
	assert(Vector3i(rotated_wheel.x,rotated_wheel.y,rotated_wheel.z)==Vector3i(1,1,-1))
	assert(rotated_wheel.turns==1 and rotated_wheel.motor_control=="A")
	rotated_wheel.erase("turns")
	Model.connect_wheels(rotated_parts)
	assert(not rotated_wheel.has("motor_control"),"A wheel cannot mount across perpendicular shafts")
	rotated["inv:cart"].parts[1].turns=4
	assert(Model.validate("inv:cart",rotated,p.data.get("blueprints",{})).contains("Part rotation"))
	assert(Profile.valid(p.data))
	assert(p.save()==OK)
	assert(p.fabricate_invention("inv:cart")=="Invention copy fabricated")
	assert(p.data.invention_copies["inv:cart"]==1)
	var reloaded:=Profile.new();reloaded.open(identity)
	assert(reloaded.data.invention_copies["inv:cart"]==1)
	var ledger:=Ledger.new()
	assert(ledger.open("user://invention_ledger_"+identity)==OK)
	var host_seed: Dictionary=reloaded.data.duplicate(true)
	host_seed.dollars=100
	var bound: Dictionary=ledger.bind(1,str(host_seed.dorm.owner),"5".repeat(64),host_seed)
	assert(bound.ok,str(bound))
	var forged: Dictionary=reloaded.data.duplicate(true)
	forged.invention_copies["inv:cart"]=99
	assert(ledger.transact(1,"forged_copies","metadata",[forged]).ok)
	assert(ledger.account(1).profile.invention_copies["inv:cart"]==1)
	var fabricated: Dictionary=ledger.transact(1,"second_copy","invention_fabricate",["inv:cart"])
	assert(fabricated.ok)
	assert(ledger.account(1).profile.invention_copies["inv:cart"]==2)
	var changed: Dictionary=ledger.account(1).profile.duplicate(true)
	changed.inventions["inv:cart"].parts.append({"type":"aluminum_frame","x":3,"y":0,"z":0,"control":"","ref":""})
	assert(not ledger.transact(1,"free_upgrade","metadata",[changed]).ok)
	var immutable: Dictionary=Model.fabricated_dependencies(ledger.account(1).profile.inventions,ledger.account(1).profile.invention_copies)
	assert(immutable.has("inv:cart") and immutable.has("inv:drive"),"A fabricated parent must freeze nested descendants")
	var child_upgrade: Dictionary=ledger.account(1).profile.duplicate(true)
	child_upgrade.inventions["inv:drive"].parts.append({"type":"plastic_shell","x":4,"y":0,"z":0,"control":"","ref":""})
	assert(Model.validate("inv:cart",child_upgrade.inventions,child_upgrade.get("blueprints",{}))=="","Nested revision fixture should be otherwise valid")
	assert(not ledger.transact(1,"child_upgrade","metadata",[child_upgrade]).ok,"Editing an embedded blueprint must not mutate fabricated parents")
	var cyclic: Dictionary=reloaded.data.inventions.duplicate(true)
	cyclic["inv:drive"].parts.append({"type":"nested","x":2,"y":0,"z":0,"control":"","ref":"inv:cart"})
	assert(Model.validate("inv:cart",cyclic,reloaded.data.get("blueprints",{}))!="")
	print("ASSEMBLY_FLOW_PASS")
	quit()
