extends RefCounted
const Catalog = preload("res://review_artifacts/open_lab_instructor_20261107/tutorials/catalog.gd")
const Session = preload("res://review_artifacts/open_lab_instructor_20261107/tutorials/session.gd")
const Policy = preload("res://review_artifacts/open_lab_instructor_20261107/tutorials/formal_guide_policy.gd")

static func run() -> void:
	assert(Catalog.COURSES=={"ac_lab":"ELM253","dc_lab":"ETY155"})
	assert(Catalog.devices("ety155_lecture").is_empty())
	assert(not Policy.allowed("Class",{"mode":"Course","course_id":"ETY155","kind":"lecture"}))
	assert(not Policy.allowed("Class",{"mode":"Course","course_id":"ELM253","kind":"lecture"}))
	assert(Policy.allowed("Class",{"mode":"Course","course_id":"ETY155","kind":"lab"}))
	assert(Policy.allowed("Class",{"mode":"Course","course_id":"ELM253","kind":"lab"}))
	assert(not Policy.allowed("Class",{"mode":"Free Lab","course_id":"ETY155","kind":"lab"}))
	assert(not Policy.allowed("Class",{}))
	assert(Policy.allowed("Open Lab",{}))
	var alice := Session.new();alice.configure(21,"dc_lab",0)
	var bob := Session.new();bob.configure(22,"dc_lab",1)
	assert(alice.choose("supply") and bob.choose("meter"))
	assert(not alice.observe({"peer_id":22,"lab_id":"dc_lab","bench_index":0,"op":"channel","key":"voltage","index":0,"accepted":true},{}))
	assert(alice.acknowledge())
	assert(not alice.acknowledge())
	assert(not alice.observe({"peer_id":21,"lab_id":"dc_lab","bench_index":0,"op":"channel","key":"voltage","index":0,"accepted":false},{}))
	assert(not alice.observe({"peer_id":21,"lab_id":"dc_lab","bench_index":1,"op":"channel","key":"voltage","index":0,"accepted":true},{}))
	assert(alice.observe({"peer_id":21,"lab_id":"dc_lab","bench_index":0,"op":"channel","key":"voltage","index":0,"accepted":true},{}))
	assert(bob.view().step_index==0)
	alice.skip();alice.restart();assert(alice.view().step_index==0)
	alice.exit();assert(not alice.view().active)
	assert(bob.start_tour())
	assert(bob.view().tour)
