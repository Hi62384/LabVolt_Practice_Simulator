extends SceneTree
const State = preload("res://scripts/campus/elevator/elevator_state.gd")
const Service = preload("res://scripts/campus/elevator/elevator_service.gd")
var failures: Array[String] = []
var checks := 0
func check(value: bool, message: String) -> void:
	checks += 1
	if not value: failures.append(message); push_error(message)
func step(state: RefCounted, seconds: float, blocked: bool = false, riders: Dictionary = {}, eligible: bool = true) -> void:
	for i in range(int(ceil(seconds / 0.1))): state.advance(0.1, blocked, riders, eligible)
func _initialize() -> void:
	var s = State.new()
	check(s.floor_id == 0 and s.phase == "open", "ground initial open")
	check(not s.request(2, true) and not s.request(-1, false), "no invented floors")
	check(s.request(1, true), "real upper button accepted")
	s.request(1, false); s.request(1, false)
	check(s.queue == [1], "simultaneous same-stop calls coalesce")
	var riders := {1:Vector3(18, 0.03, 59), 7:Vector3(20, 0.03, 60)}
	step(s, 1.3, true, riders)
	check(s.phase == "open", "doorway prevents close")
	step(s, 0.1, false, riders)
	check(s.phase == "closing", "clear doorway permits close")
	step(s, 0.2, false, riders)
	step(s, 0.1, true, riders)
	check(s.phase == "opening" and s.queue == [1], "late obstruction reopens without losing call")
	step(s, 0.9, false, riders)
	step(s, 1.3, false, riders)
	step(s, 0.9, false, riders)
	check(s.phase == "moving" and s.riders.size() == 2, "all riders captured at closure")
	check(not s.request(0, true), "moving cabin rejects floor misuse")
	check(s.request(0, false), "landing call queues during travel")
	var copy: Dictionary = s.snapshot(); copy.queue.clear(); copy.riders.clear()
	check(s.queue == [0] and s.riders.size() == 2, "replication snapshot cannot mutate authority")
	step(s, 2.3)
	check(s.floor_id == 1 and s.phase == "opening" and s.riders.size() == 2, "arrival retains riders until full door opening")
	step(s, 0.9)
	check(s.phase == "open" and s.riders.is_empty(), "opening completion releases riders")
	step(s, 1.3); step(s, 0.9); step(s, 2.3); step(s, 0.9)
	check(s.floor_id == 0 and s.phase == "open", "queued reverse call serviced with empty cabin")
	s.request(1, true); step(s, 1.3, false, riders, false)
	check(s.phase == "open", "ineligible cabin occupant blocks departure")
	step(s, 0.1, false, riders); step(s, 0.9, false, riders)
	s.forget(7)
	check(s.riders.has(1) and not s.riders.has(7), "disconnect removes only disconnected rider")
	check(Service._inside(Vector3(23.7, 1.6, 61.7), 0), "jumping/wall-adjacent rider remains in cabin set")
	check(not Service._inside(Vector3(14.5, 0, 59), 0), "hallway bystander excluded")
	check(Service._doorway(Vector3(16.75, 1.5, 60.4), 0), "capsule and jumping obstruction margins")
	check(not Service._doorway(Vector3(16, 5, 59), 0), "other-floor doorway does not block")
	for cycle in range(20):
		var repeat = State.new(); repeat.request(1, true)
		step(repeat, 1.3, false, riders); step(repeat, 0.9, false, riders); step(repeat, 2.3); step(repeat, 0.9)
		check(repeat.floor_id == 1 and repeat.riders.is_empty() and repeat.phase == "open", "repeat cycle " + str(cycle))
	print("ELEVATOR_STATE checks=", checks, " failures=", failures.size())
	quit(0 if failures.is_empty() else 1)
