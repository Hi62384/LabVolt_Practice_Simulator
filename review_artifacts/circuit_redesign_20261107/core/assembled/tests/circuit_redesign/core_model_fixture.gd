extends RefCounted
## Call run() only from runtime owner's safe test harness after installing modules.
const Model=preload("res://scripts/breadboard_model.gd")
const Placement=preload("res://scripts/electronics/circuit_workspace/placement.gd")
static func run() -> void:
	var board: Dictionary=Model.empty()
	assert(Model.node("A1",30)==Model.node("E1",30))
	assert(Model.node("A1",30)!=Model.node("F1",30))
	assert(Model.node("P15",30)!=Model.node("P16",30))
	assert(Model.node("N15",30)!=Model.node("N16",30))
	assert(Model.node("A31",30)=="")
	var before: Dictionary=board.duplicate(true)
	var placed: Dictionary=Placement.candidate(board,"r100","A1","F1",0)
	assert(placed.error=="")
	assert(board==before)
	assert(Model.validate(placed.board,{},true)=="")
	assert(Model.validate(placed.board,{},false)!="")
	assert(Placement.candidate(placed.board,"r100","A1","F2",0).error!="")
	assert(Placement.candidate(board,"r100","A1","A1",0).error!="")
	assert(Placement.candidate(board,"r100","P1","N1",1).error!="")
	assert(Placement.candidate(board,"unknown","A1","F1",0).error!="")
	var moved: Dictionary=Placement.translated(placed.board,["placement_preview"],1,0)
	assert(moved.error=="")
	assert(moved.board.parts[0].id==placed.board.parts[0].id)
	assert(moved.board.ports==placed.board.ports)
	assert(moved.board.wires==placed.board.wires)
	assert(Placement.translated(placed.board,["placement_preview"],-1,0).error!="")
