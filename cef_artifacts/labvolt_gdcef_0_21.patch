+    const auto path = utf8_to_path(directory.utf8().get_data()).make_preferred();
+    std::error_code error;
+    // The game supplies a new private directory. Existing directories,
+    // including symlinks, are rejected.
+    if (!path.is_absolute() || !fs::create_directory(path, error) || error)
+        return false;
+    m_virtual_download_directory = path;
+    return true;
+}
+
+void GdBrowserView::clearVirtualDownload()
+{
+    if (!m_virtual_download_directory.empty())
+    {
+        std::error_code error;
+        auto entry_iter = fs::directory_iterator(m_virtual_download_directory, error);
+        for (; !error && entry_iter != fs::directory_iterator(); entry_iter.increment(error))
+        {
+            const auto& entry = *entry_iter;
+            std::error_code entry_error;
+            if (fs::is_regular_file(entry.symlink_status(entry_error)) && !entry_error)
+                fs::remove(entry.path(), entry_error);
+        }
+    }
+    m_virtual_download_id = -1;
+    m_virtual_download_payload.clear();
+    m_virtual_download_callback = nullptr;
+}
+
+//------------------------------------------------------------------------------
+bool GdBrowserView::canDownload(CefRefPtr<CefBrowser>,
+                                const CefString&,
+                                const CefString&)
+{
+    return !m_virtual_download_directory.empty() && m_virtual_download_id < 0;
 }
 
