+namespace
+{
+constexpr size_t app_state_max = 4096;
+
+class StateResponse final : public CefStreamResourceHandler
+{
+public:
+    StateResponse(CefResponse::HeaderMap headers, std::shared_ptr<std::string> data)
+        : CefStreamResourceHandler(200, "OK", "application/json", std::move(headers),
+              CefStreamReader::CreateForData(data->data(), data->size())),
+          data_(std::move(data)) {}
+private:
+    const std::shared_ptr<std::string> data_;
+};
+}
+
+godot::String GdBrowserView::getOfflineState()
+{
+    if (!isOfflineProject()) return {};
+    std::lock_guard guard(m_impl->m_offline_state_mutex);
+    return godot::String::utf8(m_impl->m_offline_state.data(), m_impl->m_offline_state.size());
+}
+
+std::string GdBrowserView::Impl::offlinePath(CefRefPtr<CefRequest> request)
+{
+    const std::string url = request->GetURL().ToString();
+    constexpr std::string_view origin = "https://campus-app.invalid/";
+    if (!url.starts_with(origin))
+        return {};
+    const auto end = url.find_first_of("?#", origin.size());
+    auto path = CefURIDecode(url.substr(origin.size(), end - origin.size()), false,
+        static_cast<cef_uri_unescape_rule_t>(UU_NORMAL | UU_SPACES |
+            UU_URL_SPECIAL_CHARS_EXCEPT_PATH_SEPARATORS)).ToString();
+    const auto method = request->GetMethod();
+    return method == "GET" || (method == "PUT" && path == offline_state_path) ? path : std::string{};
+}
+
+CefRefPtr<CefResourceHandler>
+GdBrowserView::Impl::GetResourceHandler(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame>,
+                                      CefRefPtr<CefRequest> request)
+{
+    const auto path = offlinePath(request);
+    const auto asset = m_offline_files.find(path);
+    if (asset == m_offline_files.end() && path != offline_state_path)
+        return nullptr;
+
+    const auto dot = path.rfind('.');
+    const auto suffix = dot == std::string::npos ? std::string{} : path.substr(dot + 1);
+    static const std::unordered_map<std::string, std::string> mime_types = {
+        {"html","text/html"},{"htm","text/html"},{"css","text/css"},
+        {"js","text/javascript"},{"mjs","text/javascript"},{"json","application/json"},
+        {"jpg","image/jpeg"},{"jpeg","image/jpeg"},{"png","image/png"},
+        {"svg","image/svg+xml"},{"gif","image/gif"},{"webp","image/webp"},
+        {"avif","image/avif"},{"ico","image/x-icon"},{"woff","font/woff"},
+        {"woff2","font/woff2"},{"ttf","font/ttf"},{"otf","font/otf"},
+        {"wav","audio/wav"},{"mp3","audio/mpeg"},{"ogg","audio/ogg"},
+        {"mp4","video/mp4"},{"webm","video/webm"},{"wasm","application/wasm"},
+        {"txt","text/plain"},{"md","text/plain"}
+    };
+    const auto mime = mime_types.find(suffix);
+    if (mime == mime_types.end()) return nullptr;
+    CefResponse::HeaderMap headers{
+        {"Content-Security-Policy", "default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'; webrtc 'block'"},
+        {"Permissions-Policy", "camera=(), microphone=(), geolocation=(), display-capture=(), usb=(), serial=(), hid=(), bluetooth=(), clipboard-read=(), clipboard-write=()"},
+        {"Referrer-Policy", "no-referrer"},
+        {"X-Content-Type-Options", "nosniff"},
+        {"X-DNS-Prefetch-Control", "off"},
+        {"Cache-Control", "no-store"}
+    };
+    if (path == offline_state_path)
+    {
+        std::lock_guard guard(m_offline_state_mutex);
+        if (m_offline_state.empty()) return nullptr;
+        if (request->GetMethod() == "PUT")
+        {
+            const auto post = request->GetPostData();
+            if (!post || post->GetElementCount() != 1) return nullptr;
+            CefPostData::ElementVector elements;
+            post->GetElements(elements);
+            const auto part = elements.front();
+            if (part->GetType() != PDE_TYPE_BYTES || part->GetBytesCount() > app_state_max) return nullptr;
+            std::string candidate(part->GetBytesCount(), '\0');
+            part->GetBytes(candidate.size(), candidate.data());
+            const auto parsed = CefParseJSON(candidate, JSON_PARSER_RFC);
+            if (!parsed || parsed->GetType() != VTYPE_DICTIONARY) return nullptr;
+            m_offline_state = std::move(candidate);
+        }
+        return new StateResponse(std::move(headers), std::make_shared<std::string>(m_offline_state));
+    }
+    auto stream = CefStreamReader::CreateForData(const_cast<char*>(asset->second.data()), asset->second.size());
+    return new CefStreamResourceHandler(200, "OK", mime->second, headers, stream);
+}
