-    // Don't show the download dialog, just go for it
-    callback->Continue(utf8_path, false);
-
-    return false;
+    // Treat the server's proposed filename only as UI data. Chromium never
+    // receives a path influenced by a page and never opens a host dialog.
+    if (m_virtual_download_directory.empty() || m_virtual_download_id >= 0)
+        return true;
+    if (download_item->GetTotalBytes() > MAX_VIRTUAL_DOWNLOAD_BYTES)
+    {
+        emit_signal("virtual_download_finished", godot::String(), godot::String(),
+                    godot::PackedByteArray(), godot::String("The file exceeds 256 KB."));
+        return true;
+    }
+    m_virtual_download_id = download_item->GetId();
+    m_virtual_download_name = godot::String::utf8(suggested_name.ToString().c_str()).left(128);
+    const auto mime = download_item->GetMimeType().ToString();
+    const char* suffix = ".bin";
+    if (mime == "application/pdf") suffix = ".pdf";
+    else if (mime == "image/png") suffix = ".png";
+    else if (mime == "image/jpeg") suffix = ".jpg";
+    else if (mime == "image/webp") suffix = ".webp";
+    else if (mime == "application/zip") suffix = ".zip";
+    else if (mime.rfind("text/", 0) == 0) suffix = ".txt";
+    m_virtual_download_payload = m_virtual_download_directory /
+        ("payload-" + std::to_string(m_virtual_download_id) + suffix);
+    callback->Continue(path_to_utf8(m_virtual_download_payload), false);
+    return true;
 }

