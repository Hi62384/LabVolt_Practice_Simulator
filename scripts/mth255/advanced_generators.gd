extends RefCounted
const C=preload("res://scripts/mth255/complex_domain.gd")
static func make(topic: String,d: int,r: RandomNumberGenerator) -> Dictionary:
	var a=r.randi_range(1,6+d);var b=r.randi_range(1,6+d);var p={"parameters":{},"answer":{},"steps":[],"diagram":{},"input":{"kind":"structured","fields":[]},"expected_form":"structured","rubric":{"tolerance":0.000001}}
	match topic:
		"impedance_network":
			var z1=Vector2(a*10,b*5);var z2=Vector2((a+2)*10,-(b+1)*5);var z3=Vector2((b+2)*10,a*4);var voltage=Vector2(r.randi_range(12,60),0);var parallel=C.divide(C.multiply(z2,z3),z2+z3);var equivalent=z1+parallel;var total=C.divide(voltage,equivalent);var branch_voltage=C.multiply(total,parallel);var i2=C.divide(branch_voltage,z2);var i3=C.divide(branch_voltage,z3)
			p.parameters={"z1":C.encode(z1),"z2":C.encode(z2),"z3":C.encode(z3),"voltage":voltage.x};p.prompt="Ideal RMS phasors at one common frequency: Z1=%s+j*(%s) ohm is in SERIES with the PARALLEL combination of Z2=%s+j*(%s) ohm and Z3=%s+j*(%s) ohm. Source is %s V at 0 degrees. Find rectangular equivalent impedance, branch voltage across Z2/Z3, and currents in Z2 and Z3. Units: Z ohm, V volts, I amperes."%[z1.x,z1.y,z2.x,z2.y,z3.x,z3.y,voltage.x];p.answer={"z_real":equivalent.x,"z_imag":equivalent.y,"v_real":branch_voltage.x,"v_imag":branch_voltage.y,"i2_real":i2.x,"i2_imag":i2.y,"i3_real":i3.x,"i3_imag":i3.y};p.diagram={"kind":"circuit","topology":"series_parallel","components":[{"id":"Z1","real":z1.x,"imag":z1.y},{"id":"Z2","real":z2.x,"imag":z2.y},{"id":"Z3","real":z3.x,"imag":z3.y}],"source":{"rms_volts":voltage.x,"phase_degrees":0}};p.steps=[{"text":"Reduce Z2 || Z3 first, add Z1, and use source current=V/Ztotal. The divider voltage is Vbranch=Vsource*Zparallel/(Z1+Zparallel). Recover each branch current from that SAME branch voltage; check KCL and KVL."}]
		"reactance_equation":
			var inductance=a*0.01;var capacitance=b*0.00001;var omega=r.randi_range(20,150)*(d+1);var reactance=omega*inductance-1.0/(omega*capacitance)
			p.parameters={"L":inductance,"C":capacitance,"X":reactance};p.prompt="An ideal series LC network has reactance X=omega*L-1/(omega*C). L=%s H, C=%s F and X=%s ohm. Find ALL strictly positive angular frequencies omega in rad/s. State the excluded omega=0."%[inductance,capacitance,reactance];var discriminant=reactance*reactance+4*inductance/capacitance;var positive=(reactance+sqrt(discriminant))/(2*inductance);p.answer={"values":[positive],"excluded":[0]};p.expected_form="restricted_roots";p.steps=[{"text":"Multiply by omega only after excluding zero: L*omega²-X*omega-1/C=0. The product of roots is negative, so exactly one is positive. Check the original reactance expression."}]
		"rational_transformed":
			var excluded=r.randi_range(-5,5);var ex2=excluded+1;var r1=excluded+a+2;var r2=excluded-a-b-2;var A=(r1-excluded)*(r2-excluded);var B=r1+r2-excluded-ex2-A
			p.parameters={"A":A,"B":B,"excluded":excluded,"ex2":ex2};p.prompt="Solve %d/(x-(%d))+(%d)/(x-(%d))=1. Give ALL roots and ALL excluded values from the original equation."%[A,excluded,B,ex2];p.answer={"values":[r1,r2],"excluded":[excluded,ex2]};p.expected_form="restricted_roots";p.steps=[{"text":"Exclude both denominator zeros. Multiply by their product and expand to a quadratic. Solve it, then substitute every candidate into the original two-fraction equation."}]
		"radical_transformed":
			var h=r.randi_range(-5,5);var c=a+1;var m=b+1;var u=r.randi_range(1,7);var k=(u+m)*(u+m)-c*u;var other=c-2*m-u;var values=[u+h]
			if other+m>=0 and other!=u:values.append(other+h)
			p.parameters={"h":h,"c":c,"m":m,"k":k};p.prompt="Solve sqrt(%d*(x-(%d))+(%d))=(x-(%d))+(%d). Enter all real roots and the inclusive lower domain boundary required by BOTH the radical and nonnegative right side (x≥boundary). Reject roots that fail the unsquared equation."%[c,h,k,h,m];p.answer={"values":values,"boundary":maxf(h-float(k)/c,h-m)};p.steps=[{"text":"Put u=x-h and note c*u+k≥0 and u+m≥0. Square to get u²+(2m-c)u+m²-k=0. Recover x and check each candidate in the original equation, not only its square."}]
		"trig_proof":
			var scale=r.randi_range(1,8);p.parameters={"scale":scale};p.prompt="Prove %d*sin(x)^2/(%d*(1-cos(x)^2))=1 on its original domain. Step1: replace 1-cos(x)^2 using Pythagoras, leaving an explicit fraction in sin(x). Step2: simplify to a constant. Restriction code: 1 means sin(x)≠0, 0 means all real x."%[scale,scale];p.answer={"step1":"(%d*sin(x)^2)/(%d*sin(x)^2)"%[scale,scale],"step2":"1","restriction":1};p.expected_form="proof";p.rubric.expression_fields=["step1","step2"];p.steps=[{"text":"Original denominator requires sin(x)≠0. Replace 1-cos²(x) by sin²(x). Only on this original domain may the matching nonzero factors cancel to one."}]
		"log_combine":
			var u=r.randi_range(1,d+2);var v=r.randi_range(1,d+2);var w=r.randi_range(1,d+2)
			p.parameters={"u":u,"v":v,"w":w};p.prompt="On x>0,y>0,z>0, combine %d*ln(x)+%d*ln(y)-%d*ln(z) as a SINGLE ln(M) with coefficient one. Enter the algebraic argument M (not the enclosing logarithm)."%[u,v,w];p.answer={"argument":"x^%d*y^%d/z^%d"%[u,v,w]};p.rubric.expression_fields=["argument"];p.steps=[{"text":"Bring each coefficient into its argument as a power, combine sums by multiplication and differences by division, preserving the stated positive domain."}]
		"log_changebase":
			var u=r.randi_range(1,d+2);var v=r.randi_range(1,d+2);var m=r.randi_range(1,d+3);var n=r.randi_range(1,d+3)
			p.parameters={"u":u,"v":v,"m":m,"n":n};p.prompt="Let a=log10(p), b=log10(q), p,q>0, and p^%d*q^%d≠1. Express log base (p^%d*q^%d) of (p^%d*q^%d) in terms of a,b. Enter expression and the denominator expression that must be nonzero."%[u,v,u,v,m,n];p.answer={"expression":"(%d*a+%d*b)/(%d*a+%d*b)"%[m,n,u,v],"denominator":"%d*a+%d*b"%[u,v]};p.rubric.expression_fields=["expression","denominator"];p.steps=[{"text":"Use change of base with common logs, then expand powers and products. The base restriction becomes u*a+v*b≠0; positive p and q keep both base and argument positive."}]
		_:return {"error":"Unknown extension topic."}
	return p
