static func weeks(kind: String="lecture") -> Array:
	if kind!="lecture":return []
	var result: Array=[]
	for i in range(9):
		var row: Dictionary=UNITS[i].duplicate(true)
		row.merge({"week":i+1,"kind":"lecture","lecture_only":true,"course_id":"MTH147","topics":Generator.TYPES[i],"equipment":[],"duration_seconds":420,"source":{"document":"MTH147NGG.pdf","unit":i+1,"role":"topics/methods/complexity/notation only; independently authored procedural mathematics"}},true)
		result.append(row)
	return result

static func focus_for(week: int,difficulty: int,focus: String="") -> Dictionary:
	if week<1 or week>9:return {"error":"Unknown week."}
	var groups: Array=UNITS[week-1].focuses
	if focus=="all":return {"id":"all","title":"Unit review","types":Generator.TYPES[week-1]}
	for group in groups:
		if group.id==focus:return group.duplicate(true)
	if not focus.is_empty():
		var short := focus.trim_prefix("w%d."%week)
		if short in Generator.TYPES[week-1]:return {"id":short,"title":short.capitalize(),"types":[short]}
		return {"error":"Unknown lecture focus."}
	return groups[mini(groups.size()-1,int(clampi(difficulty,0,4)*groups.size()/5))].duplicate(true)
