extends PanelContainer
# Read-only: receives a sanitized host projection, never a save/profile object.
func show_profile(public_profile: Dictionary) -> void:
	for child in get_children(): remove_child(child); child.queue_free()
	theme=preload("res://scripts/campus/ui/campus_theme.gd").create()
	var style := StyleBoxFlat.new(); style.bg_color=Color("13212bf5"); style.border_color=Color("50706c"); style.set_border_width_all(1); style.set_corner_radius_all(12); style.content_margin_left=22; style.content_margin_right=22; style.content_margin_top=18; style.content_margin_bottom=18; add_theme_stylebox_override("panel",style)
	custom_minimum_size=Vector2(420,400); size=Vector2(420,560)
	var scroll := ScrollContainer.new(); scroll.custom_minimum_size=Vector2(390,500); add_child(scroll)
	var box := VBoxContainer.new(); box.size_flags_horizontal=Control.SIZE_EXPAND_FILL; box.add_theme_constant_override("separation",8); scroll.add_child(box)
	var safe := preload("res://scripts/campus/social/public_profiles.gd")
	var visibility := {}
	for key in safe.FIELDS: visibility[key]=public_profile.has(key)
	var projected: Dictionary=safe.project(str(public_profile.get("id","")),str(public_profile.get("name","Student")),public_profile,visibility)
	var name_label := Label.new(); name_label.text=projected.name; name_label.add_theme_font_size_override("font_size",24); box.add_child(name_label)
	for section in safe.FIELDS:
		if not projected.has(section): continue
		var label := Label.new(); label.text=section.capitalize(); label.modulate=Color("80dfc5"); box.add_child(label)
		for field in projected[section]:
			var value: Variant=projected[section][field]
			var lines: Array[String]=[]
			if value is Array:
				for item in value:
					lines.append((str(item.get("name","Part"))+" × "+str(item.get("count",0))) if item is Dictionary else str(item))
			else: lines.append(str(value))
			var detail := Label.new(); detail.text=field.replace("_"," ").capitalize()+": "+", ".join(lines); detail.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART; detail.custom_minimum_size.x=340; box.add_child(detail)
	var close := Button.new(); close.text="Close"; close.pressed.connect(hide); box.add_child(close)
	show()
